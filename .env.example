# PREMIUM RADAR — API Configuration
# Copy to .env and fill in your keys, or set as system environment variables.
# NEVER commit .env to git (already in .gitignore).

# ============================================================
# Webull Thailand OpenAPI (required for market data)
# ============================================================
WEBULL_APP_KEY=your_webull_app_key_here
WEBULL_APP_SECRET=your_webull_app_secret_here
# Optional: override the REST endpoint (default: https://api.webull.co.th)
# WEBULL_BASE_URL=https://api.webull.co.th

# ============================================================
# LLM for AI Copilot — any OpenAI-compatible endpoint
# ============================================================

# --- Option A: Generic (recommended — works with ANY provider) ---
# LLM_BASE_URL=https://api.z.ai
# LLM_API_KEY=your_api_key
# LLM_MODEL=glm-5.3
# LLM_LABEL=Z.ai GLM-5.3

# --- Option B: Z.ai GLM shorthand ---
# GLM_API_KEY=your_zai_api_key
# GLM_MODEL=glm-5.3

# --- Option C: OpenAI shorthand ---
# OPENAI_API_KEY=sk-your_key
# OPENAI_MODEL=gpt-4o

# --- Option D: Ollama (local, no key needed) ---
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_LABEL=Ollama Local

# --- Option E: Any other OpenAI-compatible API ---
# LLM_BASE_URL=https://your-proxy.example.com
# LLM_API_KEY=your_key
# LLM_MODEL=claude-sonnet-4-5
# LLM_LABEL=My Proxy

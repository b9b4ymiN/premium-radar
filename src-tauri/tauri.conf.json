{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PREMIUM RADAR",
  "version": "0.2.1",
  "identifier": "com.premiumradar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PREMIUM RADAR",
        "width": 1680,
        "height": 950,
        "minWidth": 1290,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "THPForge",
    "shortDescription": "CSP / Covered Call screener for US stocks via Webull Thailand API",
    "longDescription": "CSP / Covered Call screener for US stocks via Webull Thailand API",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxRUUwMUE2QjQxN0RBNDEKUldSQjJoZTBwZ0h1QVVxY3oyajgxL3NiNUtPOUkzTTRlYmNXdW5EdmN2VFVmWnQ0bmFmY2ZNcEIK",
      "endpoints": [
        "https://raw.githubusercontent.com/b9b4ymiN/premium-radar/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

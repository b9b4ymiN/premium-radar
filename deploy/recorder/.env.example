# Copy to .env and fill in real values. Never commit .env.
# Everything below is a placeholder — these are NOT real credentials.

# Webull OpenAPI app credentials.
WEBULL_APP_KEY=replace-with-your-app-key
WEBULL_APP_SECRET=replace-with-your-app-secret

# Bearer token protecting the recorder's HTTP API on :8787.
# Generate with something like: openssl rand -hex 32
RECORDER_API_TOKEN=replace-with-a-long-random-string

# Optional overrides:
# Webull access token: create it in the desktop app (Settings → create token, SMS), ~15-day lifetime.
# Or leave it unset and put the token in /data/secrets/access_token inside the volume.
WEBULL_ACCESS_TOKEN=replace-with-your-access-token
# RECORDER_BIND=0.0.0.0:8787
# RECORDER_CONFIG=/data/config.json
# TZ=Asia/Bangkok
